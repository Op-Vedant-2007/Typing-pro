{
  "name": "typeflow-app",
  "version": "1.0.0",
  "description": "TypeFlow – Intelligent Full-Stack Typing Practice & Personalized Learning Web Application",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "prisma:push": "npm --prefix backend run prisma:push",
    "seed": "npm --prefix backend run prisma:seed"
  },
  "keywords": [
    "typing",
    "monkeytype",
    "typeflow",
    "full-stack",
    "learning",
    "wpm"
  ],
  "author": "Vedant",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
